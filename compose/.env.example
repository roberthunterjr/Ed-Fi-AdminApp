# =============================================================================
# Admin App - Docker Compose environment
#
# Copy this file to compose/.env before starting the stack:
#   Copy-Item compose/.env.example compose/.env
#
# Read by `docker compose --env-file compose/.env`, which is what
# compose/start-services.ps1 and compose/start-local-dev.ps1 invoke.
# See compose/readme.md for the full walkthrough.
#
# Conventions below:
#   VAR=value     active setting
#   # VAR=value   inactive - either a documented default (uncommenting it
#                 changes nothing until you edit the value) or an alternative
#                 to the active line above it. The nearby comment says which.
#
# This file is read last-key-wins: if the same key appears twice, the LAST
# occurrence is the one that takes effect.
#
# NOTE: local hot-reload mode (`npm run start:api:dev`) does NOT read this file.
# The API resolves its settings from packages/api/config/* in that mode.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared - applies to every Ed-Fi topology below
# -----------------------------------------------------------------------------
BASE_URL=https://localhost
BASE_URL_DEV=http://localhost:3333
ALLOWED_ORIGINS=${BASE_URL}
LOGS_FOLDER=./logs
TPDM_ENABLED=true

# Npgsql connection pooling, applied to every ODS/API container.
NPG_POOLING_ENABLED=true
NPG_API_MAX_POOL_SIZE_ODS=20
NPG_API_MAX_POOL_SIZE_ADMIN=20
NPG_API_MAX_POOL_SIZE_SECURITY=20
NPG_API_MAX_POOL_SIZE_MASTER=20

# Credentials for EVERY PostgreSQL container in the stack: the ODS and Admin
# databases of all topologies, plus the Admin App's own database when the
# engine is set to pgsql. Required whichever engine the Admin App itself
# uses - the ODS and Admin databases are always PostgreSQL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Port PostgreSQL listens on INSIDE the ODS DB containers. Not published to the
# host; for that see POSTGRES_PORT_EXPOSED in the Admin App database section.
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# ODS database images (compose/DB-Ods)
#
# Every odsV7-*-db-ods container - single-tenant and multi-tenant, Admin API v2
# and v3 - is built locally from compose/DB-Ods as edfiadminapp/db-ods:local.
# The v6.2 topology instead pulls edfialliance/ods-api-db-ods:${ODS_DB_TAG_6X}.
#
# SQL_BACKUPS_FOLDER holds EdFi.Ods.Minimal.Template.sql and
# EdFi.Ods.Populated.Template.sql. These are NOT in this repo - supply your own,
# or let eng/testing/run-e2e-ui.ps1 download the minimal template into the
# default location. The path is relative to compose/; an absolute path works too.
# -----------------------------------------------------------------------------
SQL_BACKUPS_FOLDER=./db-backup
MINIMAL_SQL_PATH=/var/opt/pgsql/data/sql-backups/EdFi.Ods.Minimal.Template.sql
POPULATED_SQL_PATH=/var/opt/pgsql/data/sql-backups/EdFi.Ods.Populated.Template.sql
# Which template EdFi_Ods is cloned from: minimal | populated
EDFI_ODS_DATASET=minimal

# -----------------------------------------------------------------------------
# Ed-Fi ODS/API v7.3 - image tags shared by the Admin API v2 and v3 topologies
#
# Tags are pinned by digest so a re-tagged upstream image cannot silently change
# what you run. "pre" floats to the latest pre-release and is deliberately
# unpinned.
# -----------------------------------------------------------------------------
ODS_API_TAG_7X=v7.3.2@sha256:64ec898075da58824ab8a0f91f445abbf3cc8c225bfc7c69ed34fe84d6ef230f
# Admin database image.
ADMIN_DB_TAG_7X=pre
# Admin API image. The active value "pre" tracks the latest development build,
# so the image can change under you between pulls. For a reproducible stack,
# uncomment the pinned digest line below: this file is last-key-wins, so the
# later line overrides the "pre" above it - leave that line as it is.
ADMIN_API_TAG_7X=pre
# ADMIN_API_TAG_7X=v2.3.2@sha256:59b5816e1d39cad77bb1dbae0536940efd5a20f2cb35c9e496db70d147c1333f

# Behaviour shared by both v7 topologies.
MULTITENANCY_ENABLED=true
PAGING_OFFSET=0
PAGING_LIMIT=25
ENABLE_APPLICATION_RESET_ENDPOINT=true
SWAGGER_DEFAULT_TENANT=tenant1
# Generate a new encryption key using `openssl rand -base64 32`
ODS_CONNECTION_STRING_ENCRYPTION_KEY=vLgnKf+MyoAsEmeGsh+n+rKRN1bGS8s1b0eCo6zc5+o=
# Admin API token signing key - generate with `openssl rand -base64 32`
SIGNING_KEY=v+R+atm4BwN+Y8EavGPqGs3Gt1kBX3qEBZmwyZBG95I=

# -----------------------------------------------------------------------------
# Ed-Fi v7.x - Admin API v2 topology
# -----------------------------------------------------------------------------
ODS_V7_ADMIN_V2_SINGLE_API_VIRTUAL_NAME=odsv7-adminv2-single-api
ODS_V7_ADMIN_V2_SINGLE_ADMIN_API_VIRTUAL_NAME=odsv7-adminv2-single-adminapi
ODS_V7_ADMIN_V2_SINGLE_API_DISCOVERY_URL=https://localhost/odsv7-adminv2-single-api

ODS_V7_ADMIN_V2_MULTI_API_VIRTUAL_NAME=odsv7-adminv2-multi-api
ODS_V7_ADMIN_V2_MULTI_ADMIN_API_VIRTUAL_NAME=odsv7-adminv2-multi-adminapi
ODS_V7_ADMIN_V2_MULTI_API_DISCOVERY_URL=https://localhost/odsv7-adminv2-multi-api

# -----------------------------------------------------------------------------
# Ed-Fi v7.x - Admin API v3 topology
# -----------------------------------------------------------------------------
ODS_V7_ADMIN_V3_SINGLE_API_VIRTUAL_NAME=odsv7-adminv3-single-api
ODS_V7_ADMIN_V3_SINGLE_ADMIN_API_VIRTUAL_NAME=odsv7-adminv3-single-adminapi
ODS_V7_ADMIN_V3_SINGLE_API_DISCOVERY_URL=https://localhost/odsv7-adminv3-single-api

ODS_V7_ADMIN_V3_MULTI_API_VIRTUAL_NAME=odsv7-adminv3-multi-api
ODS_V7_ADMIN_V3_MULTI_ADMIN_API_VIRTUAL_NAME=odsv7-adminv3-multi-adminapi
ODS_V7_ADMIN_V3_MULTI_API_DISCOVERY_URL=https://localhost/odsv7-adminv3-multi-api

# -----------------------------------------------------------------------------
# Ed-Fi v6.2 topology
# -----------------------------------------------------------------------------
# Minimal template. The populated template lives in a different image
# (edfialliance/ods-api-db-ods-sandbox), which requires editing the image name
# in compose/edfi-services.yml - the image name is not configurable from here -
# and setting ODS_DB_TAG_6X to that image's own digest:
#   v2.3.5@sha256:6955ac921eb79d2fd0557befba327ebee6ab98371e77034cbb52f5e1ed088238
ODS_DB_TAG_6X=v2.3.5@sha256:fc2ebd13d53911364c6cd76c3509f607350eb32021fcebf2fe65e7a8e6faa4f0
ODS_API_TAG_6X=v2.3.5@sha256:28774e9206ba3ab074518c97924ca7618d0e81a4793b3bd1ef6be4649cc530d3
ADMIN_DB_TAG_6X=v1.4.3@sha256:69120328487ac0e0988d52fc161153c17eba32b7a4597afaccc0b3edf44f1cd8
# Admin API image. The active value "pre" tracks the latest pre-release, so the
# image can change under you between pulls. For a reproducible stack, uncomment
# the pinned digest line below: this file is last-key-wins, so the later line
# overrides the "pre" above it - leave that line as it is.
ADMIN_TAG_6X=pre
# ADMIN_TAG_6X=v1.4.2@sha256:518df6820e019003939a4842d86533314776b16d190606e4c26ecb22b3341adb

V6_ODS_VIRTUAL_NAME=v6-api
V6_ADMIN_API_VIRTUAL_NAME=v6-adminapi
API_INTERNAL_URL=http://v6-api:8080
ODS_API_62_DISCOVERY=https://localhost/v6-api

# -----------------------------------------------------------------------------
# Keycloak (identity provider)
# -----------------------------------------------------------------------------
KEYCLOAK_TAG=26.1@sha256:044a457e04987e1fff756be3d2fa325a4ef420fa356b7034ecc9f1b693c32761
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_LOG_CONSOLE_LEVEL=error
# Secrets for the "edfiadminapp" (container mode) and "edfiadminapp-dev" (hot
# reload) Keycloak clients. Local-development values - change on a shared host.
KEYCLOAK_EDFIADMINAPP_CLIENT_SECRET=big-secret-123
KEYCLOAK_EDFIADMINAPP_DEV_CLIENT_SECRET=big-secret-123
# Optional, shown with their compose fallbacks. Set KEYCLOAK_HOSTNAME when
# serving the stack from anything other than localhost.
# KEYCLOAK_HOSTNAME=localhost
# KEYCLOAK_HOSTNAME_PROTOCOL=https
# KEYCLOAK_PORT_EXPOSED=8080
# KEYCLOAK_REALM_CONFIG_TEMPLATE=./adminapp/realm-config.json

# -----------------------------------------------------------------------------
# Admin App frontend
# -----------------------------------------------------------------------------
VITE_API_URL=https://localhost/adminapp-api
VITE_OIDC_ID=1
VITE_BASE_PATH=/adminapp/
VITE_HELP_GUIDE=https://docs.ed-fi.org/reference/admin-app-v4
VITE_STARTING_GUIDE=${VITE_HELP_GUIDE}/system-administrators/global-administration-tasks
VITE_CONTACT=https://community.ed-fi.org
VITE_IDP_ACCOUNT_URL=https://localhost/auth/realms/edfi/account/
VITE_APPLICATION_NAME="Ed-Fi Admin App"
# NOT currently forwarded to the edfiadminapp-fe container, so setting this has
# no effect in container mode. Tracked in AC-603.
VITE_SHOW_REQUEST_CERTIFICATION=false

# -----------------------------------------------------------------------------
# Admin App database
# -----------------------------------------------------------------------------
# Database engine pgsql or mssql
DB_ENGINE=pgsql
# Note: compose defaults this to true when unset (adminapp-services.yml).
DB_SSL=false # or "true" if you want encryption
DB_TRUST_CERTIFICATE=false # or "true" if you want to trust the server certificate
DB_TTL_IN_MINUTES=120 # Time to live for DB sessions in minutes
ADMIN_APP_DB_NAME=sbaa
## PostgreSQL (DB_ENGINE=pgsql). Credentials come from POSTGRES_USER and
## POSTGRES_PASSWORD in the Shared section above.
# .. if you change this port, you must also update packages/api/config/local.js
POSTGRES_PORT_EXPOSED=5432
# POSTGRESQL_IMAGE_TAG=16.2
## SQL Server. To switch engines: (1) set DB_ENGINE=mssql above, (2) set
## MSSQL_SA_PASSWORD below, (3) swap the active DB_SECRET_VALUE at the bottom of
## this file. The other MSSQL_* lines below match the compose defaults in
## adminapp-services.yml, so uncommenting them changes nothing.
##
## WARNING: eng/testing/run-e2e-ui.ps1 (Set-AdminAppEnvFile) line-regex patches
## DB_ENGINE above, the MSSQL_* lines below, and both DB_SECRET_VALUE lines to
## build the .env for the mssql E2E matrix leg. Changing their spelling, the
## spacing after '#', or their order breaks that CI run - update the regexes
## there if you change these lines.
# MSSQL_PORT_EXPOSED=1433
# MSSQL_ACCEPT_EULA=Y
# Required - no default is provided. Set a strong password before running, and
# use the same value for MSSQL_DB_PASSWORD in the mssql DB_SECRET_VALUE below.
# MSSQL_SA_PASSWORD=
# MSSQL_IMAGE_TAG=2022-latest
# MSSQL_PID=Express

# -----------------------------------------------------------------------------
# Admin App API
# -----------------------------------------------------------------------------
# For Node to trust the self-signed certificate
NODE_EXTRA_CA_CERTS=/app/ssl/server.crt
SSL_VERIFICATION=true # Set to false to disable SSL verification for outgoing requests (e.g., to the database or Yopass). Not recommended for production environments.
USE_YOPASS=true
YOPASS_URL=http://edfiadminapp-yopass:80
# Extra flags for the API container's Node process, e.g. --max-old-space-size=4096
# API_NODE_OPTIONS=
# Certification artifact configuration
CERT_BRUNO_SRC_REF='v2.1.0' # Tag name or commit ref
CERT_BRUNO_SRC_CHECKSUM='71840f51f464c60d7b90c7bbf08d9be039df291d51dd69085ffc4703b98f11e6' # SHA-256 checksum of the artifact zip file for integrity verification
## CERT_BRUNO_ON_DOWNLOAD_ERROR => Whether to error out or just warn if there's a problem downloading or initializing the certification artifact.
## Note: If set to 'warning' and there's a problem with the certification artifact, any API routes depending on it will fail at runtime when they attempt to use the artifact.
CERT_BRUNO_ON_DOWNLOAD_ERROR='warning' # error | warning.
## DB_SECRET_VALUE — JSON object with DB connection settings for the API container.
## Set one of the following depending on the value of DB_ENGINE above.
## Keep DB_USERNAME / DB_PASSWORD / DB_DATABASE in sync with POSTGRES_USER,
## POSTGRES_PASSWORD and ADMIN_APP_DB_NAME above - they are not interpolated.
## For mssql, MSSQL_DB_PASSWORD below must match MSSQL_SA_PASSWORD above.
## PostgreSQL (DB_ENGINE=pgsql):
DB_SECRET_VALUE={"DB_HOST":"edfiadminapp-postgres","DB_PORT":5432,"DB_USERNAME":"postgres","DB_PASSWORD":"postgres","DB_DATABASE":"sbaa"}
## SQL Server (DB_ENGINE=mssql):
# DB_SECRET_VALUE={"MSSQL_DB_HOST":"edfiadminapp-mssql","MSSQL_DB_PORT":1433,"MSSQL_DB_USERNAME":"sa","MSSQL_DB_PASSWORD":"YourStrong!Passw0rd","MSSQL_DB_DATABASE":"sbaa"}
